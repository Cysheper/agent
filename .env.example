# LLM（必填）
DEEPSEEK_MODULE_NAME=deepseek-chat
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_API_KEY=在这里填入你的 API Key

# Agent（可选，有默认值）
context_length=40
compress_length=20
compress_prompt=将以下内容压缩为简短的摘要，简要描述做了什么。

# 网关（可选，默认 3000）
agent_port=3000

# Embedding API（记忆功能，可选）
EMBEDDING_API_BASE=https://maas.qianwenaiapi.com/compatible-mode/v1
EMBEDDING_API_KEY=在这里填入你的 Embedding API Key
EMBEDDING_MODLE=qwen3.7-text-embedding-flash

# Input
## QQ Bot（可选）
AppID=你的QQ机器人AppID
AppSecret=你的QQ机器人AppSecret
